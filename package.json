{
  "name": "cat-talk",
  "version": "1.0.0",
  "private": true,
  "description": "Bongo Cat 로비 채팅 데스크톱 메신저 (bongo-cat-chat 포크)",
  "author": "postcat23",
  "license": "PolyForm-Noncommercial-1.0.0",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "vite",
    "build": "tsc -p renderer && vite build",
    "build:sidecar": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-sidecar.ps1",
    "dist": "npm run build && npm run build:sidecar && electron-builder --win --publish never",
    "release": "npm run build && npm run build:sidecar && electron-builder --win --publish always"
  },
  "build": {
    "appId": "CatTalk.Desktop",
    "productName": "Cat Talk",
    "directories": { "output": "dist" },
    "files": ["electron/**", "renderer/dist/**", "package.json"],
    "extraResources": [
      { "from": "artifacts/sidecar/cattalk-sidecar", "to": "sidecar-bin" },
      { "from": "src/bongo_chat/feature-contract.json", "to": "src/bongo_chat/feature-contract.json" },
      { "from": "artifacts/compatibility", "to": "artifacts/compatibility" },
      { "from": "artifacts/auto_chest", "to": "artifacts/auto_chest" },
      { "from": "LICENSE", "to": "LICENSE" },
      { "from": "NOTICE", "to": "NOTICE" },
      { "from": "THIRD-PARTY-NOTICES.md", "to": "THIRD-PARTY-NOTICES.md" },
      { "from": "LICENSES", "to": "LICENSES" }
    ],
    "win": { "target": "nsis", "icon": "electron/app-icon.ico" },
    "nsis": { "oneClick": true, "perMachine": false, "createDesktopShortcut": false, "artifactName": "Cat-Talk-Setup-${version}.${ext}" },
    "publish": { "provider": "github", "owner": "postcat23", "repo": "Cat-Talk" }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "koffi": "^3.3.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
