# 로컬 작업 폴더 (루트 한정 — 하위 경로의 동명 폴더는 추적된다)
/.claude/
/.sw/

# 의존성 · 빌드 산출물
node_modules/
dist/
build/
out/
# 호환성 툴체인 빌드 산출물(exe·dll·Version.cs·nupkg) — 기기마다 tools/prepare-compatibility.ps1로 재빌드
artifacts/

# 환경 변수
.env
.env.*
# 버그 신고 웹훅(빌드 시크릿, D-050) — 커밋 금지. CI가 Actions 시크릿으로 만든다
/electron/report-webhook.json

# 파이썬
__pycache__/
*.py[cod]
.venv/
venv/
